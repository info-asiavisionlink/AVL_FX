# Trading Gateway Environment Variables
# Copy to .env and fill in values

# Trading View専用Supabase (ConsoleのSupabaseとは別プロジェクト)
SUPABASE_URL=https://your-trading-view-project.supabase.co
SUPABASE_SERVICE_KEY=your-trading-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-trading-service-role-key

# Trading Gateway認証シークレット (Customer MT5 Bridgeと同じ値を設定)
MT5_GATEWAY_SECRET=your-trading-gateway-secret

# Gateway起動ポート
MT5_WEBSOCKET_PORT=8080
PORT=8080

# Supabaseバッチ設定 (オプション)
SUPABASE_BATCH_SIZE=500
SUPABASE_BATCH_DELAY_MS=50

# SUPABASE_SERVICE_KEY is read first; SUPABASE_SERVICE_ROLE_KEY is accepted as an alias.
# Use ONE of them (Railway uses SUPABASE_SERVICE_KEY).

# Watcher dispatch: Gateway → Trading View /api/watcher/m5-close
APP_URL=
WATCHER_SECRET=

# Console monitoring (optional)
CONSOLE_MONITORING_URL=
CONSOLE_SYSTEM_TOKEN=

# NOTE: never put a Supabase personal access token (sbp_…) in this file or in
# the Gateway runtime environment — the Gateway does not use it.
