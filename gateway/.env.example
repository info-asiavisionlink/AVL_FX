# Trading Gateway Environment Variables
# Copy to .env and fill in values

# Trading View専用Supabase (ConsoleのSupabaseとは別プロジェクト)
SUPABASE_URL=https://your-trading-view-project.supabase.co
SUPABASE_SERVICE_KEY=your-trading-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-trading-service-role-key

# Trading Gateway認証シークレット (Customer MT5 Bridgeと同じ値を設定)
MT5_GATEWAY_SECRET=your-trading-gateway-secret

# Gateway起動ポート
MT5_WEBSOCKET_PORT=8080
PORT=8080

# Supabaseバッチ設定 (オプション)
SUPABASE_BATCH_SIZE=500
SUPABASE_BATCH_DELAY_MS=50
