# ==================================================
# AVLFX Trading View — .gitignore
# ==================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
.next-stale-*/
# Root-only: src/app/api/**/build/ are source route directories.
/out/
/build/

# Testing
/coverage/

# Environment — NEVER commit secrets
# Catch-all first, then re-allow only the two placeholder templates.
.env
.env.*
**/.env
**/.env.*
!/.env.example
!/gateway/.env.example

# Keys / credentials
*.pem
*.key
*.p12
*.pfx
"OPEN AI APIリストのコピー"/
OPEN\ AI\ API*/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Gateway
gateway/node_modules/
gateway/dist/
gateway/data/
gateway/.next/

# MT5 compiled binaries (source .mq5 のみ管理)
# public/ea/*.ex5 is a customer download served by the app and IS tracked.
ea/*.ex5
ea/*.ex4
mt5/**/*.ex5
mt5/**/*.ex4
mt5/**/*.log

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/
.claire/

# Orchestrator runtime error dumps (local only)
reports/orchestrator/review-error-*.json

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs
*.log
/tmp/*.log
