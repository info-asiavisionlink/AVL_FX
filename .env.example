# ==================================================
# AVLFX Trading View — Environment Variables
# ==================================================
#
# このファイルは .env.example です。
# 実際の値を .env.local にコピーして設定してください。
#   cp .env.example .env.local
#
# IMPORTANT:
#   - .env.local は絶対に Git にコミットしないこと
#   - Trading ViewはConsoleのENVを共有しない
#   - Trading View専用Supabaseを使用すること
# ==================================================


# ==================================================
# Supabase (Trading View専用 — ConsoleのSupabaseと別プロジェクト)
# ==================================================

# Trading View専用Supabaseプロジェクト URL
NEXT_PUBLIC_SUPABASE_URL=https://your-trading-view-project.supabase.co

# Trading View専用 Publishable Key (Anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-trading-publishable-key

# Trading View専用 Service Role Key (Server-sideのみ)
SUPABASE_SERVICE_ROLE_KEY=your-trading-service-role-key


# ==================================================
# Trading Gateway (Trading View専用Gateway)
# ==================================================

# Trading Gateway URL (Railway等でデプロイ)
NEXT_PUBLIC_MT5_GATEWAY_HTTP_URL=https://your-trading-gateway.up.railway.app
NEXT_PUBLIC_MT5_GATEWAY_WS_URL=wss://your-trading-gateway.up.railway.app
MT5_GATEWAY_URL=https://your-trading-gateway.up.railway.app

# Trading Gateway認証シークレット
MT5_GATEWAY_SECRET=your-trading-gateway-secret

# ローカル開発時のGatewayポート
MT5_WEBSOCKET_PORT=8080


# ==================================================
# AI / LLM
# ==================================================

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1


# ==================================================
# Stripe (SaaS Billing — 将来削除予定)
# ==================================================

# STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
# STRIPE_PRICE_STARTER=price_STARTER_PRICE_ID
# STRIPE_PRICE_PRO=price_PRO_PRICE_ID
# STRIPE_PRICE_BUSINESS=price_BUSINESS_PRICE_ID


# ==================================================
# External APIs
# ==================================================

# Twelve Data API (経済指標等)
# TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Resend (Contact Form)
# RESEND_API_KEY=re_your-resend-api-key
# FROM_EMAIL=noreply@your-domain.com


# ==================================================
# Application
# ==================================================

APP_URL=http://localhost:3000
NODE_ENV=development


# ==================================================
# Future: Research API (AVL Historical Data)
# 将来: Backtestデータ参照をResearch APIへ移行予定
# ==================================================

# AVL_RESEARCH_API_URL=https://your-research-api.example.com
# AVL_RESEARCH_ACCESS_TOKEN=your-research-access-token
