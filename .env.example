# ==================================================
# AVL FX v2 - Environment Variables
# ==================================================
#
# このファイルは .env.example です。
# 実際の値を設定する場合は .env にコピーして使用してください。
#   cp .env.example .env
#
# セキュリティ上の注意:
#   - .env は絶対に Git にコミットしないこと
#   - .gitignore に .env が含まれていることを必ず確認すること
#   - 本番環境の秘密鍵はパスワードマネージャーで管理すること
#   - NEXT_PUBLIC_ プレフィックスの変数はブラウザに公開されるため
#     秘密情報を含めないこと
#
# ==================================================


# ==================================================
# Application
# アプリケーション基本設定
# ==================================================

# アプリケーション名（UI表示やメタ情報に使用）
APP_NAME=AVL FX

# アプリケーションのベースURL（メール内リンク・OAuthリダイレクトに使用）
APP_URL=http://localhost:3000

# 実行環境（development | staging | production）
NODE_ENV=development

# Next.js / Node.js サーバーのリスニングポート
PORT=3000


# ==================================================
# Supabase
# データベース・認証・リアルタイムサブスクリプション
# Phase1〜全フェーズで使用
# ==================================================

# Supabase プロジェクト URL（ダッシュボード > Settings > API で確認）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key（公開鍵・フロントエンドで使用）
# Row Level Security (RLS) を必ず設定すること
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key（秘密鍵・サーバーサイドのみで使用）
# 絶対にブラウザに公開しないこと。RLSをバイパスするため厳重管理
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ==================================================
# Authentication
# ユーザー認証（NextAuth.js）
# Phase1で実装予定
# ==================================================

# NextAuth.js のセッション暗号化シークレット
# 生成コマンド: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# NextAuth.js のベースURL（APP_URLと同じ値でよい）
NEXTAUTH_URL=http://localhost:3000


# ==================================================
# MT5 Gateway
# MetaTrader5 との通信設定
# EA (MQL5) から価格データ・注文情報・ポジション情報を受信する
# Phase1（価格取得）で使用開始
# ==================================================

# MT5 Gateway サーバーのURL（EAがHTTPで接続するエンドポイント / サーバーサイド用）
MT5_GATEWAY_URL=http://localhost:8080

# MT5 Gateway との通信に使用する共有シークレット（改ざん防止・認証用）
# 生成コマンド: openssl rand -hex 32
MT5_GATEWAY_SECRET=your-mt5-gateway-secret

# Gateway の起動ポート（HTTP + WebSocket 共通）
MT5_WEBSOCKET_PORT=8080

# フロントエンド（ブラウザ）からGatewayへのHTTP接続URL
NEXT_PUBLIC_MT5_GATEWAY_HTTP_URL=http://localhost:8080

# フロントエンド（ブラウザ）からGatewayへのWebSocket接続URL
NEXT_PUBLIC_MT5_GATEWAY_WS_URL=ws://localhost:8080


# ==================================================
# TradingView Charting Library
# チャート表示に使用するライブラリ設定
# TradingViewからの価格取得は行わない。MT5データを使用
# Phase1で使用開始
# ==================================================

# TradingView Charting Library の配置パス
# public/ 以下に charting_library/ を配置した場合の相対パス
NEXT_PUBLIC_TRADINGVIEW_LIBRARY_PATH=/charting_library/

# カスタム Datafeed API のエンドポイント（MT5データをTVに渡すアダプター）
NEXT_PUBLIC_TRADINGVIEW_DATAFEED=http://localhost:3000/api/datafeed


# ==================================================
# Economic Calendar
# 経済指標カレンダーAPI
# Phase1で使用開始
# ==================================================

# 経済指標APIのAPIキー（例: Twelve Data / ForexFactory / Trading Economics）
ECONOMIC_CALENDAR_API_KEY=your-economic-calendar-api-key

# 経済指標APIのベースURL
ECONOMIC_CALENDAR_URL=https://api.example.com/v1


# ==================================================
# AI / LLM
# AI分析エンジン設定
# Phase3（AI分析）で使用開始
# 使用するプロバイダーのキーのみ設定すればよい
# ==================================================

# OpenAI API キー（GPT-4o / GPT-4 Turbo によるトレンド分析・エントリー判定）
# Phase3: トレンド分析 / RR分析 / エントリー判定 / ニュース分析
OPENAI_API_KEY=sk-your-openai-api-key

# 使用するOpenAIモデル名（例: gpt-4o / gpt-4-turbo）
OPENAI_MODEL=gpt-4o

# Anthropic API キー（Claude によるニュース分析・複合推論）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google AI API キー（Gemini によるマルチモーダル分析・将来拡張用）
GOOGLE_AI_API_KEY=your-google-ai-api-key


# ==================================================
# Redis
# キャッシュ・セッション・リアルタイムデータのバッファリング
# Phase2以降で使用開始（価格キャッシュ・シグナル管理）
# ==================================================

# Redis 接続URL（ローカル: redis://localhost:6379 / Upstash: rediss://...）
REDIS_URL=redis://localhost:6379


# ==================================================
# Database (Direct Connection)
# Supabase以外のDB直接接続が必要な場合に使用
# Prisma ORM などと組み合わせる際に設定
# ==================================================

# PostgreSQL 接続URL（Supabase の Connection Pooler URLを推奨）
DATABASE_URL=postgresql://user:password@localhost:5432/avlfx


# ==================================================
# Logging
# ログレベル設定
# ==================================================

# ログレベル（error | warn | info | http | debug）
# 本番環境では warn または error を推奨
LOG_LEVEL=debug


# ==================================================
# Email
# メール送信（Resend）
# パスワードリセット・通知メールに使用
# Phase1（認証実装時）で使用
# ==================================================

# Resend API キー（https://resend.com）
RESEND_API_KEY=re_your-resend-api-key

# 送信元メールアドレス（Resendで認証済みドメインのアドレスを使用）
FROM_EMAIL=noreply@your-domain.com


# ==================================================
# Storage
# ファイルストレージ（Vercel Blob）
# チャートスナップショット・レポートPDFの保存に使用
# Phase3以降で使用予定
# ==================================================

# Vercel Blob の読み書きトークン
BLOB_READ_WRITE_TOKEN=vercel_blob_your-token


# ==================================================
# Security
# 追加セキュリティ設定
# ==================================================

# JWT 署名シークレット（MT5 Gateway との認証トークン生成に使用）
# 生成コマンド: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-min-64-chars

# データ暗号化キー（APIキーなどの機密データをDBに保存する際の暗号化）
# 生成コマンド: openssl rand -hex 32 （必ず32バイト = 64文字の16進数）
ENCRYPTION_KEY=your-encryption-key-32-bytes-hex


# ==================================================
# Monitoring & Analytics (Optional)
# モニタリング・分析ツール
# 本番環境での障害検知・ユーザー行動分析に使用
# ==================================================

# Sentry DSN（エラートラッキング・パフォーマンスモニタリング）
# https://sentry.io でプロジェクト作成後に取得
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# PostHog API キー（プロダクトアナリティクス・機能フラグ）
# https://posthog.com
# POSTHOG_API_KEY=phc_your-posthog-api-key


# ==================================================
# Future Broker Support
# 将来対応予定のブローカーAPI
# Phase5以降（完全自動売買）で段階的に追加予定
# MT5以外のブローカーへの対応時に使用
# ==================================================

# OANDA API キー（CFD・FX自動売買）
# OANDA_API_KEY=your-oanda-api-key

# IC Markets API キー（MT5連携の代替 / cTrader対応時）
# ICMARKETS_API_KEY=your-icmarkets-api-key

# Pepperstone API キー（cTrader Connect API）
# PEPPERSTONE_API_KEY=your-pepperstone-api-key

# Binance API キー（暗号資産対応時）
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-api-secret
